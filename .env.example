# Copy to .env.local, or run `vercel env pull` to have Vercel write the real values.
# Never commit .env.local.

# Pooled Postgres connection (Supabase transaction pooler, port 6543). The running app uses this one.
SUPABASE_POSTGRES_URL=postgres://postgres.your-project-ref:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Session connection (port 5432). Migrations, the seed script and the tests use it.
# Tests need it because they set search_path on the connection, which the transaction pooler would share between clients.
# If it is missing, SUPABASE_POSTGRES_URL is used instead.
SUPABASE_POSTGRES_URL_NON_POOLING=postgres://postgres.your-project-ref:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional. Run the Playwright test against a deployed site instead of a local build.
# E2E_BASE_URL=https://your-deployment.vercel.app
