# Copy to .env.local, or run `vercel env pull` to have Vercel write the real values.
# Never commit .env.local.

# Pooled Postgres connection. The running app uses this one.
DATABASE_URL=postgres://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection. Migrations, the seed script and the tests use it.
# Tests need it because they set search_path at connect time, which the pooler ignores.
# If it is missing, DATABASE_URL is used instead.
DATABASE_URL_UNPOOLED=postgres://user:password@your-project.region.aws.neon.tech/neondb?sslmode=require

# Optional. Run the Playwright test against a deployed site instead of a local build.
# E2E_BASE_URL=https://your-deployment.vercel.app
